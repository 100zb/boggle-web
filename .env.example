# Copier en .env pour travailler en local (le .env n'est jamais versionne)
# En ligne, ces variables sont dans Render > Environment

# dev affiche les erreurs, prod les cache (prod par defaut)
APP_ENV=dev
# adresse du site, utilisee dans le lien du mot de passe oublie
APP_URL=http://localhost:8000

# PostgreSQL : toujours le role boggle_web, jamais le proprietaire
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boggle
DB_USER=boggle_web
DB_PASSWORD=
DB_SSLMODE=disable

# cle de chiffrement des emails (pgcrypto) et du hmac : openssl rand -hex 32
CLE=

# SMTP (Brevo en ligne : smtp-relay.brevo.com, port 2525, tls)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# tls (STARTTLS), ssl (port 465) ou aucun (serveur de test local)
SMTP_SECURE=tls
MAIL_FROM=
# oui pour voir l'echange SMTP dans le journal (a remettre a non ensuite)
SMTP_DEBUG=non

# oui derriere le proxy de Render (lecture de X-Forwarded-For)
DERRIERE_PROXY=non
